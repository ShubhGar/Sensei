JIRA_API_TOKEN="ATATT3xFfGF0-Hcg6eF-Ry4LI_Fq7OE1uYX0iI_eMyKSnycue4D9OTOG5-Fz0TMfGjd3YB1zu791q1sV5SNJWpID38MrSlkg0xOOXGW9HWG-FIjQs4MXYfAj5x23OfeSBZe1M66tuMJvN-WlYCb7jvVISZhUR9iRQzLvtH2riqhnG01EeDNiPs0=D4A4B3FB"

# JIRA Board URL (optional - if provided, will extract assignee ID and project from board URL)
# Example: https://payuindia.atlassian.net/jira/software/c/projects/MS/boards/404/backlog?assignee=5ff44d42692b79011008616e
# This allows fetching issues from a specific board/filter
# The system will automatically extract:
#   - Project key (e.g., "MS" from /projects/MS/)
#   - Assignee ID (e.g., "5ff44d42692b79011008616e" from ?assignee=...)
# Supports both account ID formats: "5ff44d42692b79011008616e" or "712020:30247fee-020e-4e67-ba74-40b5aec20ad0"
JIRA_BOARD_URL=https://payuindia.atlassian.net/jira/software/c/projects/MS/boards/404/backlog?assignee=5ff44d42692b79011008616e

# JIRA Project Key (optional - if not extracted from JIRA_BOARD_URL, you can set it here)
# Example: MS
# This filters issues to a specific project
# JIRA_PROJECT_KEY=MS

