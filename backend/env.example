# CORS Configuration
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Provider Configuration
# Set to "true" to use AWS Bedrock, "false" to use OpenAI (default: false)
USE_BEDROCK=false

# OpenAI Configuration
# Your OpenAI API key for AI-powered features (MOM generation, email summarization, etc.)
# Only used if USE_BEDROCK=false
OPENAI_API_KEY=your_openai_api_key_here
# OpenAI model to use (default: gpt-4o)
# Options: gpt-4o, gpt-4-turbo, gpt-4o-mini, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o
# Fallback OpenAI model if primary model is not available (default: gpt-3.5-turbo)
OPENAI_FALLBACK_MODEL=gpt-3.5-turbo

# AWS Bedrock Configuration
# Only used if USE_BEDROCK=true
# AWS region for Bedrock (default: us-east-1)
AWS_REGION=us-east-1
# AWS Access Key ID for Bedrock access
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS Secret Access Key for Bedrock access
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# Bedrock model ID (default: anthropic.claude-3-haiku-20240307-v1:0)
# Other options: anthropic.claude-3-5-sonnet-20240620-v1:0, anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Transcription Service Configuration
# Deepgram API key for transcription service
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# Set to "true" to use Deepgram, "false" to use local Whisper model
USE_DEEPGRAM=false
# Local Whisper model name (e.g., "base", "small", "medium", "large", "large-v2", "large-v3")
# Only used if USE_DEEPGRAM=false
# Recommended: "small" for good balance, "medium" or "large-v3" for best accuracy
# Note: Larger models are more accurate but slower and require more memory
LOCAL_WHISPER_MODEL=small

# Audio Capture Configuration
# Allow fallback to default input device (microphone) if system audio device (BlackHole) is not found
# Set to "true" to allow fallback (default), "false" to require system audio device
# Note: Fallback will use microphone input, not true system audio capture
AUDIO_ALLOW_FALLBACK=true

# Manually specify audio device by index or name (partial match)
# Examples: AUDIO_DEVICE=2 or AUDIO_DEVICE="BlackHole" or AUDIO_DEVICE="Multi-Output"
# Leave unset to auto-detect system audio devices
#AUDIO_DEVICE=

# Audio capture method: 'pyaudio' (default) or 'ffmpeg'
# PyAudio is recommended for real-time capture
# FFmpeg can be used as alternative but requires device to be specified
#AUDIO_CAPTURE_METHOD=pyaudio

# Microsoft Teams/Outlook Integration
# Microsoft Azure App Registration Client ID
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
# Microsoft Azure App Registration Client Secret
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
# Microsoft Azure Tenant ID (use "common" for multi-tenant or your specific tenant ID)
MICROSOFT_TENANT_ID=your_microsoft_tenant_id_here
# Microsoft OAuth Redirect URI (must match Azure app registration)
# This should point to your backend callback endpoint
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
# Frontend URL for redirects after authentication
FRONTEND_URL=http://localhost:3000

