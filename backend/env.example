# CORS Configuration
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Provider Configuration
# Set to "true" to use AWS Bedrock as primary, "false" to use OpenAI as primary (default: false)
USE_BEDROCK=false

# Enable/Disable Providers (can be set to "false" to completely disable a provider)
# Set ENABLE_OPENAI=false to disable OpenAI completely (useful if you only want Bedrock)
ENABLE_OPENAI=true
# Set ENABLE_BEDROCK=false to disable Bedrock completely (useful if you only want OpenAI)
ENABLE_BEDROCK=true

# Ensemble Mode: Use both OpenAI and Bedrock in parallel for improved accuracy
# When enabled, both providers process the same request simultaneously and results are intelligently merged
# This provides better accuracy but uses more API credits and takes slightly longer
# Requires both ENABLE_OPENAI=true and ENABLE_BEDROCK=true
USE_ENSEMBLE_MODE=true

# OpenAI Configuration
# Your OpenAI API key for AI-powered features (MOM generation, email summarization, etc.)
# Only used if USE_BEDROCK=false
OPENAI_API_KEY=your_openai_api_key_here
# OpenAI model to use (default: gpt-4o)
# Options: gpt-4o, gpt-4-turbo, gpt-4o-mini, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o
# Fallback OpenAI model if primary model is not available (default: gpt-3.5-turbo)
OPENAI_FALLBACK_MODEL=gpt-3.5-turbo

# AWS Bedrock Configuration
# Only used if USE_BEDROCK=true
# AWS region for Bedrock (default: us-east-1)
AWS_REGION=us-east-1
# AWS Access Key ID for Bedrock access
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS Secret Access Key for Bedrock access
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# Bedrock model ID (default: anthropic.claude-3-haiku-20240307-v1:0)
# Other options: anthropic.claude-3-5-sonnet-20240620-v1:0, anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Transcription Service Configuration
# Priority order: AssemblyAI > Deepgram > Local Whisper
# Set to "assemblyai" to use Assembly AI (recommended - best accuracy, free tier available)
# Set to "deepgram" to use Deepgram cloud service
# Set to "whisper" or leave unset to use local Whisper model
TRANSCRIPTION_PROVIDER=assemblyai

# Assembly AI Configuration (recommended - 93.3%+ accuracy, speaker diarization)
# Get your API key from https://www.assemblyai.com/app/account
# Free tier: $50 credits (~185 hours of transcription)
ASSEMBLYAI_API_KEY=b09b208149e540968535ec246bfc6ca2

# Deepgram API key for transcription service
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# Set to "true" to use Deepgram, "false" to use local Whisper model (deprecated - use TRANSCRIPTION_PROVIDER instead)
USE_DEEPGRAM=false
# Local Whisper model name for faster-whisper
# Options: "distil-small.en" (fastest, least accurate), "small.en" (balanced), "base.en", "medium.en" (recommended for accuracy), "large-v3.en" (best accuracy)
# Or without .en suffix: "small", "medium", "large-v3" (supports multiple languages)
# Only used if USE_DEEPGRAM=false
# Recommended: "medium.en" for best accuracy (default changed to medium.en for improved transcription quality)
# Note: Larger models are more accurate but slower and require more memory
# Note: Models with .en suffix are English-only and faster; models without suffix support multiple languages
# For maximum accuracy, use "medium.en" or "large-v3.en" (requires more RAM: ~2GB for medium, ~5GB for large-v3)
LOCAL_WHISPER_MODEL=medium.en

# Whisper Model Performance Settings (Optional - defaults are optimized for accuracy)
# Device: "cpu" (default), "cuda" (if GPU available), or "auto" (auto-detect)
# WHISPER_DEVICE=cpu
# Compute Type: "int8" (fastest, CPU, most compatible), "int8_float16" (balanced, CPU), "float16" (GPU), "float32" (most accurate, GPU)
# For CPU: "int8" is most compatible, "int8_float16" provides better accuracy if supported
# Note: If "int8_float16" fails, the system will automatically fallback to "int8" or "float32"
# Recommended for compatibility: WHISPER_COMPUTE_TYPE=int8
# Recommended for accuracy (if supported): WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_COMPUTE_TYPE=int8

# Audio Capture Configuration
# Allow fallback to default input device (microphone) if system audio device (BlackHole) is not found
# Set to "true" to allow fallback (default), "false" to require system audio device
# Note: Fallback will use microphone input, not true system audio capture
AUDIO_ALLOW_FALLBACK=true

# Manually specify audio device by index or name (partial match)
# Examples: AUDIO_DEVICE=2 or AUDIO_DEVICE="BlackHole" or AUDIO_DEVICE="Multi-Output"
# Leave unset to auto-detect system audio devices
#AUDIO_DEVICE=

# Audio capture method: 'pyaudio' (default) or 'ffmpeg'
# PyAudio is recommended for real-time capture
# FFmpeg can be used as alternative but requires device to be specified
#AUDIO_CAPTURE_METHOD=pyaudio

# Microsoft Teams/Outlook Integration
# Microsoft Azure App Registration Client ID
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
# Microsoft Azure App Registration Client Secret
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
# Microsoft Azure Tenant ID (use "common" for multi-tenant or your specific tenant ID)
MICROSOFT_TENANT_ID=your_microsoft_tenant_id_here
# Microsoft OAuth Redirect URI (must match Azure app registration)
# This should point to your backend callback endpoint
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
# Frontend URL for redirects after authentication
FRONTEND_URL=http://localhost:3000

